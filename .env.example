# =====================================================================
# RailPredict AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =====================================================================

# ----- Database (Timescale Cloud or self-hosted) -----
DATABASE_URL=postgresql+asyncpg://railpredict:password@localhost:5432/railpredict

# ----- Redis (Upstash or local) -----
REDIS_URL=redis://localhost:6379

# ----- JWT Auth -----
JWT_SECRET_KEY=change-me-to-a-long-random-string-before-deploy
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ----- Environment -----
ENVIRONMENT=development   # development | staging | production

# ----- Sentry (error monitoring) -----
# Leave blank to disable; fill in your Sentry DSN to enable
SENTRY_DSN=

# ----- API service -----
API_PORT=8000

# ---- Next.js public vars (prefix NEXT_PUBLIC_) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
